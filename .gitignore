# Generated pipeline artifacts — rebuilt by `python3 -m sop_pipeline.cli run`.
# Keeping these out of git avoids committing ~2 MB of PNGs and a 1.7 MB dashboard
# on every run, and prevents noisy binary diffs.
output/

# Real SOP corpora are confidential — never commit client documents.
# data/sops/ is YOUR corpus and is ignored wholesale (except its README).
# The demo corpus lives in examples/mock_corpus/ and IS tracked.
data/sops/*
!data/sops/README.md
data/sops_real/
data/sops_client/
*.private.md

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.ipynb_checkpoints/

# macOS / editors
.DS_Store
.vscode/
.idea/
*.swp

# Credentials — never commit API keys
.env
.env.*
!.env.example
