# Copy to .env and fill in. NEVER commit the real .env — it is gitignored.
#
# Nothing here is required: the pipeline runs fully offline without any key.
# The only key the pipeline reads is ANTHROPIC_API_KEY, and only m06_rewriter
# uses it. Without it, m06 runs its rule-based engine and reports "rule-based".

# Anthropic API key — enables the LLM rewrite path in m06_rewriter.
# Get one at https://console.anthropic.com/settings/keys
# Also requires: pip install anthropic
ANTHROPIC_API_KEY=

# Optional: override the model m06 uses (defaults to claude-opus-4-8).
# ANTHROPIC_MODEL=claude-opus-4-8
